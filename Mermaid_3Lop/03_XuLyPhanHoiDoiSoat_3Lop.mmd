---
title: "Thiết kế 3 lớp - UC03 - Xử lý phản hồi đối soát"
---
%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff", "classText": "#000000"}}}%%
classDiagram
direction TB
classDef default fill:#ffffff,stroke:#000000,color:#000000;

%% ================= TẦNG GIAO DIỆN (GUI) =================
class MHXacNhanPhanHoi {
  -txtTimKiem: TextBox
  -chipTrangThai: RadioButtonGroup
  -dsPhanHoi: GridView
  -btnXuLy: Button
  -btnXemChiTiet: Button
  --
  +HienThi(): void
  +TaiDanhSachChoXuLy(): void
  +txtTimKiem_Change(tuKhoa: String): void
  +btnXuLy_Click(maDoiSoat: String): void
  +HienThiThongBao(thongBao: String): void
}

class MHChiTietPhanHoiDoiSoat {
  -lblMaDoiSoat: Label
  -lblHoTenKhach: Label
  -txtPhanHoiKhachHang: TextArea
  -dsKhoanKhauTru: GridView
  -lblTienCocBanDau: Label
  -lblTongKhauTru: Label
  -lblSoTienHoanThucTe: Label
  -lblSoTienKhachPhaiTT: Label
  -lblKetQuaDoiSoat: Label
  -btnXacNhanDieuChinh: Button
  -btnGiuNguyenDoiSoat: Button
  -btnDong: Button
  --
  +HienThiChiTiet(maDoiSoat: String): void
  +HienThiThongTinKhachHang(doiSoat: Object): void
  +HienThiKhauTru(dsChiTietKhauTru: List): void
  +btnXacNhanDieuChinh_Click(): void
  +btnGiuNguyenDoiSoat_Click(): void
}

%% ================= TẦNG NGHIỆP VỤ (BUS) =================
class DoiSoatBUS {
  -maDoiSoat: String
  -maPhieuTra: String
  -trangThaiDoiSoat: String
  -tienCocBanDau: Decimal
  -tongKhauTru: Decimal
  -soTienHoanThucTe: Decimal
  -soTienKhachPhaiTT: Decimal
  --
  +LayDanhSachChoXuLyPhanHoi(maNhanVien: String): List~DoiSoat~
  +LayChiTietPhanHoi(maDoiSoat: String, maNhanVien: String): DoiSoat
  +KiemTraDieuKienXuLy(maDoiSoat: String): Boolean
  +XacDinhTrangThaiTiepTheo(tienHoan: Decimal, tienThuThem: Decimal): String
  +XacNhanDieuChinh(maDoiSoat: String, maNhanVien: String): Boolean
  +GiuNguyenDoiSoat(maDoiSoat: String, maNhanVien: String): Boolean
}

class ChiTietKhauTruBUS {
  -maChiTietKhauTru: String
  -maDoiSoat: String
  -loaiKhauTru: String
  -soTien: Decimal
  -moTa: String
  --
  +LayDanhSachKhauTru(maDoiSoat: String): List~ChiTietKhauTru~
}

class PhieuTraPhongBUS {
  -maPhieuTra: String
  -trangThai: String
  --
  +ChuyenTrangThaiChoKyBienBan(maPhieuTra: String): Boolean
}

%% ================= TẦNG DỮ LIỆU (DAL - THEO SCHEMA) =================
class DoiSoatDB {
  --
  +DocDanhSachPhanHoi(maNhanVien: String): List~DoiSoat~
  +DocChiTietDoiSoat(maDoiSoat: String): DoiSoat
  +CapNhatTrangThaiDoiSoat(maDoiSoat: String, trangThaiMoi: String): Boolean
}

class ChiTietKhauTruDB {
  --
  +DocChiTietKhauTru(maDoiSoat: String): List~ChiTietKhauTru~
}

class PhieuTraPhongDB {
  --
  +CapNhatTrangThaiPhieu(maPhieuTra: String, trangThaiMoi: String): Boolean
}

%% Giao dien -> Nghiep vu
MHXacNhanPhanHoi o-- DoiSoatBUS
MHChiTietPhanHoiDoiSoat o-- DoiSoatBUS
MHChiTietPhanHoiDoiSoat o-- ChiTietKhauTruBUS
MHChiTietPhanHoiDoiSoat o-- PhieuTraPhongBUS

%% Nghiep vu -> Du lieu
DoiSoatBUS o-- DoiSoatDB
DoiSoatBUS o-- PhieuTraPhongDB
ChiTietKhauTruBUS o-- ChiTietKhauTruDB
PhieuTraPhongBUS o-- PhieuTraPhongDB

%% Ep bo cuc 3 hang: Giao dien / Nghiep vu / Du lieu
MHXacNhanPhanHoi ~~~ MHChiTietPhanHoiDoiSoat
DoiSoatBUS ~~~ ChiTietKhauTruBUS
ChiTietKhauTruBUS ~~~ PhieuTraPhongBUS
DoiSoatDB ~~~ ChiTietKhauTruDB
ChiTietKhauTruDB ~~~ PhieuTraPhongDB
