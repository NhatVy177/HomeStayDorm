---
title: "Thiết kế 3 lớp - UC04 - Thanh lý trả phòng"
---
%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff", "classText": "#000000"}}}%%
classDiagram
direction TB
classDef default fill:#ffffff,stroke:#000000,color:#000000;

%% ================= TẦNG GIAO DIỆN (GUI) =================
class MHThanhLyTraPhong {
  -txtTimKiem: TextBox
  -dsPhieuTraPhong: GridView
  -btnThanhLy: Button
  -btnXemChiTiet: Button
  --
  +HienThi(): void
  +TaiDanhSach(): void
  +btnThanhLy_Click(maPhieuTra: String): void
  +HienThiThongBao(thongBao: String): void
}

class MHChiTietThanhLyTraPhong {
  -lblMaPhieuTra: Label
  -lblTrangThaiPhieuTra: Label
  -lblHoTenKhach: Label
  -lblMaHoSo: Label
  -lblKetQuaDoiSoat: Label
  -lblTrangThaiDoiSoat: Label
  -btnXacNhanThanhLyHoSo: Button
  -btnDong: Button
  --
  +HienThiChiTiet(maPhieuTra: String): void
  +HienThiKetQuaDoiSoat(doiSoat: Object): void
  +btnXacNhanThanhLyHoSo_Click(): void
}

%% ================= TẦNG NGHIỆP VỤ (BUS) =================
class PhieuTraPhongBUS {
  -maPhieuTra: String
  -maHopDong: String
  -maPhieuDatCoc: String
  -trangThai: String
  --
  +LayDanhSachChoThanhLy(maNhanVien: String): List~PhieuTraPhong~
  +LayChiTietChoThanhLy(maPhieuTra: String, maNhanVien: String): Object
  +XacDinhTrangThaiTiepTheo(trangThaiDoiSoat: String, coHopDong: Boolean): String
  +KiemTraDieuKienThanhLy(maPhieuTra: String): Boolean
  +XacNhanThanhLy(maPhieuTra: String, maNhanVien: String): Boolean
}

class DoiSoatBUS {
  -maDoiSoat: String
  -maPhieuTra: String
  -trangThaiDoiSoat: String
  --
  +KiemTraTrangThaiHopLeChoThanhLy(trangThai: String): Boolean
  +LayDoiSoatTheoPhieuTra(maPhieuTra: String): DoiSoat
}

class HopDongThueBUS {
  -maHopDong: String
  -trangThai: String
  --
  +ThanhLyHopDongThue(maHopDong: String): Boolean
}

%% ================= TẦNG DỮ LIỆU (DAL - THEO SCHEMA) =================
class PhieuTraPhongDB {
  --
  +DocDanhSachThanhLy(maNhanVien: String): List~PhieuTraPhong~
  +DocChiTietThanhLy(maPhieuTra: String): PhieuTraPhong
  +CapNhatTrangThaiPhieu(maPhieuTra: String, trangThai: String): Boolean
}

class DoiSoatDB {
  --
  +DocDoiSoat(maDoiSoat: String): DoiSoat
}

class HopDongThueDB {
  --
  +CapNhatTrangThaiHopDong(maHopDong: String, trangThai: String): Boolean
}

%% Giao dien -> Nghiep vu
MHThanhLyTraPhong o-- PhieuTraPhongBUS
MHChiTietThanhLyTraPhong o-- PhieuTraPhongBUS
MHChiTietThanhLyTraPhong o-- DoiSoatBUS
MHChiTietThanhLyTraPhong o-- HopDongThueBUS

%% Nghiep vu -> Du lieu
PhieuTraPhongBUS o-- PhieuTraPhongDB
PhieuTraPhongBUS o-- HopDongThueDB
DoiSoatBUS o-- DoiSoatDB
HopDongThueBUS o-- HopDongThueDB

%% Ep bo cuc 3 hang: Giao dien / Nghiep vu / Du lieu
MHThanhLyTraPhong ~~~ MHChiTietThanhLyTraPhong
PhieuTraPhongBUS ~~~ DoiSoatBUS
DoiSoatBUS ~~~ HopDongThueBUS
PhieuTraPhongDB ~~~ DoiSoatDB
DoiSoatDB ~~~ HopDongThueDB
