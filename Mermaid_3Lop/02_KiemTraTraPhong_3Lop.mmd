%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff", "classText": "#000000"}}}%%
classDiagram
direction TB
classDef default fill:#ffffff,stroke:#000000,color:#000000;

%% ================= TẦNG GIAO DIỆN (GUI) =================
class MHKiemTraTraPhong {
  -txtTimKiem: TextBox
  -chipTrangThai: RadioButtonGroup
  -dsPhieuTraPhong: GridView
  -btnLapBienBan: Button
  -btnXacNhan: Button
  -btnXemChiTiet: Button
  --
  +HienThi(): void
  +TaiDanhSachChoXuLy(trangThai: String): void
  +btnLapBienBan_Click(maPhieuTra: String): void
  +btnXacNhan_Click(maPhieuTra: String): void
  +HienThiThongBao(thongBao: String): void
}

class MHLapBienBanKiemTra {
  -dtpNgayKiemTra: DatePicker
  -txtTinhTrangPhong: TextArea
  -cboTinhTrangTra: ComboBox
  -txtSoLuongHuMat: TextBox
  -lblChiPhiTamTinh: Label
  -txtMoTaHuHong: TextBox
  -btnLuuBienBan: Button
  -btnDong: Button
  --
  +HienThiChiTietKiemTra(maPhieuTra: String): void
  +HienThiNghiaVu(dsHoaDon: List, dsViPham: List): void
  +HienThiTaiSan(dsTaiSan: List): void
  +dsTaiSan_Change(maTaiSan: String, mucDoHuHong: String, soLuong: Integer): void
  +TinhTongChiPhiTamTinh(): Decimal
  +btnLuuBienBan_Click(): void
}

class MHXacNhanHoSoDatCoc {
  -lblMaPhieuTra: Label
  -lblMaHoSo: Label
  -lblPhongGiuong: Label
  -btnXacNhan: Button
  -btnDong: Button
  --
  +HienThiHoSoDatCoc(maPhieuTra: String): void
  +btnXacNhan_Click(): void
}

%% ================= TẦNG NGHIỆP VỤ (BUS) =================
class PhieuTraPhongBUS {
  -maPhieuTra: String
  -maHopDong: String
  -maPhieuDatCoc: String
  -ngayDangKyTra: Date
  -ngayDuKienTra: Date
  -ngayTraThucTe: Date
  -trangThai: String
  --
  +LayDanhSachChoXuLy(maNhanVien: String, trangThai: String): List~PhieuTraPhong~
  +LayChiTietPhieu(maPhieuTra: String, maNhanVien: String): Object
  +KiemTraTrangThaiHopLe(maPhieuTra: String): Boolean
  +ChuyenSangChoDoiSoat(maPhieuTra: String): Boolean
}

class TaiSanBUS {
  -maTaiSan: String
  -tenTaiSan: String
  -soLuongHuMat: Integer
  -mucDoHuHong: String
  -chiPhiSuaChua: Decimal
  --
  +LayTaiSanTheoPhieuTra(maPhieuTra: String): List~TaiSan~
  +TinhTyLeHuHong(mucDoHuHong: String): Decimal
  +TinhChiPhiBoiThuongTamTinh(soLuongHuMat: Integer, donGia: Decimal, tyLe: Decimal): Decimal
}

class NghiaVuBUS {
  -danhSachHoaDon: List~HoaDon~
  -danhSachViPham: List~BienBanViPham~
  -tongTienNo: Decimal
  -tongTienPhat: Decimal
  --
  +LayDanhSachHoaDonNo(maHopDong: String): List~HoaDon~
  +LayDanhSachViPhamChuaXuLy(maHopDong: String): List~BienBanViPham~
}

class BienBanKiemTraBUS {
  -maBienBanKiemTra: String
  -maPhieuTra: String
  -ngayKiemTra: Date
  -tinhTrangPhong: String
  --
  +LapBienBanKiemTra(maPhieuTra: String, maNhanVien: String, danhSachHuHong: List): Boolean
  +KiemTraThongTinBienBanHopLe(danhSachHuHong: List): Boolean
}

class PhieuDatCocBUS {
  -maPhieuDatCoc: String
  -maKhachHang: String
  -trangThaiCoc: String
  -ngayDatCoc: Date
  -tienCoc: Decimal
  --
  +XacNhanHoSoDatCoc(maPhieuTra: String, maNhanVien: String): Boolean
}

%% ================= TẦNG DỮ LIỆU (DAL - THEO SCHEMA) =================
class PhieuTraPhongDB {
  --
  +DocDanhSachChoXuLy(maNhanVien: String, trangThai: String): List~PhieuTraPhong~
  +DocChiTietPhieuTra(maPhieuTra: String): PhieuTraPhong
  +CapNhatTrangThaiPhieu(maPhieuTra: String, trangThaiMoi: String): Boolean
}

class HoaDonDB {
  --
  +DocHoaDonChuaThanhToan(maHopDong: String): List~HoaDon~
}

class BienBanViPhamDB {
  --
  +DocViPhamChuaXuLy(maHopDong: String): List~BienBanViPham~
}

class ChiTietBanGiaoDB {
  --
  +DocChiTietBanGiaoVao(maHopDong: String): List~ChiTietBanGiao~
}

class BienBanKiemTraPhongDB {
  --
  +ThemBienBanKiemTra(bienBan: BienBanKiemTraPhong): Boolean
}

class ChiTietKiemTraDB {
  --
  +ThemChiTietKiemTra(chiTiet: ChiTietKiemTra): Boolean
}

class PhieuDatCocDB {
  --
  +DocPhieuDatCoc(maPhieuDatCoc: String): PhieuDatCoc
}

%% Giao dien -> Nghiep vu
MHKiemTraTraPhong o-- PhieuTraPhongBUS
MHLapBienBanKiemTra o-- PhieuTraPhongBUS
MHLapBienBanKiemTra o-- TaiSanBUS
MHLapBienBanKiemTra o-- NghiaVuBUS
MHLapBienBanKiemTra o-- BienBanKiemTraBUS
MHXacNhanHoSoDatCoc o-- PhieuDatCocBUS
MHXacNhanHoSoDatCoc o-- PhieuTraPhongBUS

%% Nghiep vu -> Du lieu
PhieuTraPhongBUS o-- PhieuTraPhongDB
TaiSanBUS o-- ChiTietBanGiaoDB
NghiaVuBUS o-- HoaDonDB
NghiaVuBUS o-- BienBanViPhamDB
BienBanKiemTraBUS o-- BienBanKiemTraPhongDB
BienBanKiemTraBUS o-- ChiTietKiemTraDB
BienBanKiemTraBUS o-- PhieuTraPhongDB
PhieuDatCocBUS o-- PhieuDatCocDB
PhieuDatCocBUS o-- PhieuTraPhongDB

%% Ep bo cuc 3 hang: Giao dien / Nghiep vu / Du lieu
MHKiemTraTraPhong ~~~ MHLapBienBanKiemTra
MHLapBienBanKiemTra ~~~ MHXacNhanHoSoDatCoc
PhieuTraPhongBUS ~~~ TaiSanBUS
TaiSanBUS ~~~ NghiaVuBUS
NghiaVuBUS ~~~ BienBanKiemTraBUS
BienBanKiemTraBUS ~~~ PhieuDatCocBUS
PhieuTraPhongDB ~~~ ChiTietBanGiaoDB
ChiTietBanGiaoDB ~~~ HoaDonDB
HoaDonDB ~~~ BienBanViPhamDB
BienBanViPhamDB ~~~ BienBanKiemTraPhongDB
BienBanKiemTraPhongDB ~~~ ChiTietKiemTraDB
ChiTietKiemTraDB ~~~ PhieuDatCocDB
